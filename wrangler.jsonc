// Cloudflare Workers: the website from dist/ plus the waterfront room server (worker/).
{
  "name": "alongside",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "./dist" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // PR preview links (`wrangler preview`). Bindings are not inherited, so the room is listed again;
  // each preview gets its own, separate waterfront.
  "previews": { "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] } }
}
